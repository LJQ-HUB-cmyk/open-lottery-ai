# MySQL 配置
MYSQL_HOST=192.168.2.10
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=openun-lottery

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Celery Broker (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 训练配置
MODEL_SAVE_DIR=./models
DEVICE=cuda

# 休市日期（逗号分隔 ISO 日期）：休市期间无开奖，目标开奖日自动跳过
# 国庆休市：10/1 0:00 停止销售，10/5 0:00 恢复销售
LOTTERY_HOLIDAYS=2026-10-01,2026-10-02,2026-10-03,2026-10-04

# 自我进化闭环（Celery Beat 定时调度）
SELF_EVOLVE_ENABLED=true
SELF_EVOLVE_N_MODELS=15
SELF_EVOLVE_HOUR=9
SELF_EVOLVE_MINUTE=30

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# Agent 相关配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_ENABLED=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_TOP_K=3